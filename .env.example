# Discord Developer Portal > General Information > Application ID
DISCORD_APPLICATION_ID=
# Discord Developer Portal > Bot > Token. Treat this like a password.
DISCORD_BOT_TOKEN=
# Plex local server and token. The token is sent only in X-Plex-Token.
PLEX_SERVER_URL=http://127.0.0.1:32400
PLEX_TOKEN=
PLEX_POLL_INTERVAL_SECONDS=5
PLEX_GRACE_PERIOD_MINUTES=15

# Manual /stay-awake limits.
STAY_AWAKE_MAX_MINUTES=480

